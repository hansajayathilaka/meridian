{
  "name": "shared-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Meridian shared UI: Svelte primitives + the framework-agnostic MeridianClientAdapter TS boundary, shared by the browser (apps/web) and desktop (Tauri) shells. ADR 0012.",
  "//": "typescript is pinned to ~5.9.3: typescript-eslint 8.x, svelte-check 4.x and svelte2tsx declare peer ranges that exclude TypeScript 7 (7.0.2 was latest at install time). Revisit when those tools support it. The `shared-ui/contract-tests` subpath imports vitest and is for adapter test suites only; it is not re-exported from the production entry.",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./adapter": {
      "types": "./src/lib/adapter.ts",
      "default": "./src/lib/adapter.ts"
    },
    "./fake-adapter": {
      "types": "./src/lib/fake-adapter.ts",
      "default": "./src/lib/fake-adapter.ts"
    },
    "./contract-tests": {
      "types": "./src/contract/index.ts",
      "default": "./src/contract/index.ts"
    }
  },
  "sideEffects": [
    "**/*.svelte"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
