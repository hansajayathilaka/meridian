# Copy into Dokploy's "Environment" tab for this compose app (or a plain `.env` file next to
# dokploy.compose.yml for `docker compose up`). Every var here maps 1:1 onto a compose interpolation
# in dokploy.compose.yml — see that file for what each one actually configures.
#
# Required (no default — the compose file fails fast at deploy time if these are unset):
RENDEZVOUS_IMAGE=yourdockerhubuser/meridian-rendezvous:latest
MERIDIAN_RENDEZVOUS_SERVER__DOMAIN=chat.example.com
TURN_SHARED_SECRET=
# This host's public IP (coturn runs on Docker's bridge network — without this it hands clients
# its private container IP as the relay candidate and every relayed call fails). Same IP
# TURN_DOMAIN below should resolve to.
TURN_EXTERNAL_IP=

# --- Networking ---------------------------------------------------------------------------------
RENDEZVOUS_PORT=8443
TURN_DOMAIN=turn.example.com
# coturn's relay allocations live in this range — bounded down from its 49152-65535 default so
# dokploy.compose.yml can publish it as one short Docker port range. Widen it (matching
# `--min-port`/`--max-port` in dokploy.compose.yml's `command:`, which read the same vars) if you
# expect enough concurrent relayed calls to exhaust ~200 allocations.
TURN_RELAY_MIN_PORT=49152
TURN_RELAY_MAX_PORT=49352

# --- Images --------------------------------------------------------------------------------------
COTURN_IMAGE=coturn/coturn:latest

# --- [server] --------------------------------------------------------------------------------------
MERIDIAN_RENDEZVOUS_SERVER__ADMISSION=open
MERIDIAN_RENDEZVOUS_SERVER__INVITE_TOKENS=[]
MERIDIAN_RENDEZVOUS_SERVER__DATABASE_URL=sqlite:///data/rendezvous.db

# --- [limits] — anti-abuse, fixed one-minute windows ---------------------------------------------
MERIDIAN_RENDEZVOUS_LIMITS__AUTH_PER_IP_PER_MIN=60
MERIDIAN_RENDEZVOUS_LIMITS__FETCH_PER_ACCOUNT_PER_MIN=120
MERIDIAN_RENDEZVOUS_LIMITS__ROUTE_PER_ACCOUNT_PER_MIN=600
MERIDIAN_RENDEZVOUS_LIMITS__TURN_PER_ACCOUNT_PER_MIN=60

# --- [turn] ----------------------------------------------------------------------------------------
# Both left unset here on purpose: dokploy.compose.yml derives them from TURN_DOMAIN above by
# default. Uncomment only to override that derived value directly.
# MERIDIAN_RENDEZVOUS_TURN__REALM=turn.example.com
# Set explicitly to add a turns:// entry once coturn has a real TLS cert — see dokploy.compose.yml's
# comment on this var.
# MERIDIAN_RENDEZVOUS_TURN__URLS=["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"]
MERIDIAN_RENDEZVOUS_TURN__TTL_SECS=120
